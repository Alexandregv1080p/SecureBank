# Copie para backend.hcl (ignorado pelo Git). Use com: terraform init -backend-config=../../backend.hcl -backend-config="key=<env>/terraform.tfstate"
bucket       = "securebank-tfstate-CONTA"  # criado à parte: versionado, cifrado (SSE-KMS), sem acesso público
region       = "us-east-1"
encrypt      = true
use_lockfile = true # lock nativo do S3 (Terraform >= 1.10), sem DynamoDB
