# Copie para .env (ignorado pelo Git) e troque os valores. Nunca commitar segredos.
DB_USER=securebank
DB_PASSWORD=change-me

# Portas no host (as padrão evitam conflito com outros projetos locais)
DB_PORT=5439
API_PORT=8100
WEB_PORT=3500

# Redis (rate limit e denylist de sessões)
REDIS_PASSWORD=change-me
REDIS_PORT=6380

# Chave AES-256 em Base64 que cifra os segredos TOTP: openssl rand -base64 32
MFA_ENCRYPTION_KEY=change-me

# Primeiro ADMIN (opcional). A senha precisa passar na política (12+ caracteres, sem conter o e-mail)
BOOTSTRAP_ADMIN_EMAIL=staff@securebank.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-passphrase

